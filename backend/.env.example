# Copy to .env and adjust as needed. All values have sensible defaults in code.

# Database: default local Postgres. For a no-Docker smoke test use:
#   DATABASE_URL=sqlite:///./hr.db
# The backend loads this file automatically through python-dotenv.
DATABASE_URL=postgresql://hr:hr_password@localhost:5432/hr_ats

# Auth
SECRET_KEY=change-me-in-production-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resume storage directory (local disk; replaces MinIO for MVP)
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
CANDIDATE_PORTAL_URL=http://localhost:5173
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_ENCRYPTION_KEY=replace-with-a-dedicated-fernet-key
REDIS_URL=redis://localhost:6380/0

# Agent provider: "heuristic" (default, no API key) or "llm" (needs LLM_API_KEY)
AGENT_PROVIDER=heuristic
# LLM_API_KEY=

# CORS: comma-separated allowed origins for the two frontends
CORS_ORIGINS=http://localhost:5173,http://localhost:5177,http://127.0.0.1:5173,http://127.0.0.1:5177
